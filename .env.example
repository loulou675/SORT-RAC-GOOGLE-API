# Keep the Google key server-side. Configure it in Vercel as GEMINI_API_KEY.
# Do not prefix it with VITE_ and do not commit a real value.
GEMINI_API_KEY=

# The frontend talks to /api/analyze-image; it never receives the key.
VITE_CAMERA_START_TIMEOUT_MS=12000
VITE_RESULT_FEEDBACK=false
VITE_FEEDBACK_AUTO_UPLOAD=false
